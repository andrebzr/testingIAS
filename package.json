{
  "name": "vr-audio-motion",
  "version": "1.0.0",
  "private": true,
  "description": "Campanha procedural de 15 segundos para VR Áudio",
  "scripts": {
    "start": "remotion studio src/index.ts --port=3000",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/prepare-assets.mjs",
    "audio": "python3 scripts/generate-audio.py",
    "stills": "node scripts/review.mjs",
    "audit:safe": "node scripts/audit-safe-area.mjs",
    "render": "node scripts/render.mjs",
    "verify": "python3 scripts/verify-output.py"
  },
  "dependencies": {
    "@fontsource/archivo": "5.2.8",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "playwright-core": "^1.56.1",
    "typescript": "5.9.3"
  }
}
